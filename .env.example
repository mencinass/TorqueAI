# ==============================================================================
# Automotive AI Agent - Environment Configuration Template
# ==============================================================================

# Application General Settings
PROJECT_NAME="TorqueAI"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="automotive-ai-insecure-dev-secret-key-change-me"
LOG_LEVEL="INFO"

# PostgreSQL Configuration
POSTGRES_USER="automotive_user"
POSTGRES_PASSWORD="automotive_pass"
POSTGRES_DB="automotive_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
# If running backend outside containers, set POSTGRES_HOST=localhost
DATABASE_URL="postgresql+asyncpg://automotive_user:automotive_pass@postgres:5432/automotive_db"

# Qdrant Vector Database Configuration
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
# If running backend outside containers, set QDRANT_HOST=localhost
# Vehicle-specific manuals collection and general mechanics collection
QDRANT_COLLECTION="automotive_manuals"
GENERAL_MECHANICS_COLLECTION="general_mechanics"

# LLM Providers
# Ollama runs as a containerized service (see docker-compose.yml) with GPU access.
# qwen3.8:latest is the spec default; on GPUs with < 18 GB VRAM (e.g. RTX 3060 12 GB)
# it offloads to CPU (~7 tok/s, 60-90 s per answer). Set qwen2.5:7b there instead.
CHAT_PROVIDER="ollama"
CHAT_MODEL="qwen3.8:latest"
CHAT_TIMEOUT=120
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=800
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="bge-m3"
EMBEDDING_DIM=1024
AUTO_INGEST_ENABLED=true
AUTO_INGEST_FORCE=false
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_PORT=11434
# Optional external providers:
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_CHAT_MODEL="deepseek-ai/deepseek-v4-pro-0813"
NVIDIA_RATE_LIMIT_RPM=40
# Authentication (single admin) — change these before any real deployment
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"

