# ==============================================================================
# Automotive AI Agent - Backend Specific Environment Variables
# ==============================================================================
PROJECT_NAME="Automotive AI Agent"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="automotive-ai-insecure-dev-secret-key-change-me"
LOG_LEVEL="INFO"

# Database Configuration (Docker network default hostname is 'postgres')
POSTGRES_USER="automotive_user"
POSTGRES_PASSWORD="automotive_pass"
POSTGRES_DB="automotive_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://automotive_user:automotive_pass@postgres:5432/automotive_db"

# Qdrant Vector DB (Docker network default hostname is 'qdrant')
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""

# Ollama endpoint (published by the ollama container on the host)
OLLAMA_BASE_URL="http://localhost:11434"

